{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake-configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "build",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--target", "all"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "flash-jlink",
            "type": "shell",
            "command": "JLink",
            "args": [
                "-Device", "STM32F407VG",
                "-If", "SWD",
                "-Speed", "4000",
                "-CommandFile", "\"${workspaceFolder}/Package/Script/flash.jlink\""
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "dependsOn":["build"]
        },
        {
            "label": "flash-jlink-nobuild",
            "type": "shell",
            "command": "JLink",
            "args": [
                "-Device", "STM32F407VG",
                "-If", "SWD",
                "-Speed", "8000",
                "-CommandFile", "\"${workspaceFolder}/Package/Script/flash.jlink\""
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
        },
        {
            "label": "start-gdbserver",
            "type": "shell",
            "command": "JLinkGDBServerCL",
            "args": [
                "-device", "STM32F407VG",
                "-if", "SWD",
                "-speed", "8000",
                "-port", "2331",
                "-noir"
            ],
            "isBackground": true,
            "problemMatcher": {
            "pattern": [
                {
                    "regexp": ".",
                    "file": 1,
                    "location": 2,
                    "message": 3
                }
            ],
            "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Listening on.*", // 根据你的 JLink 启动输出内容调整
                    "endsPattern": ".*Connected to target.*" // 可选，用于判断任务完成
                }
            }
        },
        {
            "label": "kill-gdbserver",
            "type": "shell",
            "command": "taskkill",
            "args": [
                "/F",
                "/IM",
                "JLinkGDBServerCL.exe"
            ],
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            }
        }
    ]
}
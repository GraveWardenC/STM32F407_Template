// .vscode/launch.json
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GDB Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Package/Output/TEMPLATE.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "setupCommands": [
                {
                    "text": "target remote localhost:2331"
                },
                {
                    "text": "monitor reset"
                },
                {
                    "text": "file"
                },
                {
                    "text": "b main"
                }
            ],
            "preLaunchTask": "start-gdbserver",
            "postDebugTask": "kill-gdbserver"
        }
    ]
}
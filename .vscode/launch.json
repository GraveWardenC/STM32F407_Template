{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex-Debug",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/Package/Output/TEMPLATE.elf", // 修改为你的 .elf 路径
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "device": "STM32F407VG", // 根据实际芯片型号修改
            "interface": "swd",
            "svdFile": "${workspaceFolder}/Package/STM32F407.svd", // SVD 文件路径（可选，用于外设查看）
            // "rtos": "C:/Program Files/SEGGER/JLink_V828/GDBServer/RTOSPlugin_FreeRTOS.dll",
            "runToEntryPoint": "main",
            "armToolchainPath": "D:/ST/CubeCli/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin", // 工具链路径
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 1, // liveWatch 采样率最低1s
                "showDisassembly": "auto"
            },
            "preLaunchTask": "flash-jlink"
        },
        {
            "name": "GDB Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Package/Output/TEMPLATE.elf",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "setupCommands": [
                {
                    "text": "target remote localhost:2331"
                },
                {
                    "text": "monitor reset"
                },
                {
                    "text": "break main"
                },
            ],
            "svdPath": "${workspaceFolder}/Package/STM32F407.svd",
            "stopAtEntry": true,
            "preLaunchTask": "flash-jlink"
        }
    ]
}